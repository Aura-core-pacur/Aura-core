<dow id="main_window" title="Aura Core - Test Dow" width="1280" height="720" theme="system">
    <container layout="vertical" padding="10" background="#121212">
        <navbar height="50" layout="horizontal" align="center">
            <button id="btn_back" icon="arrow_left" action="navigate_back" />
            <input id="url_bar" type="text" placeholder="aura://start" flex="1" text_color="#FFFFFF"/>
            <button id="btn_download" icon="download" action="aura_net_download_file" data-url="target_url" />
        </navbar>

        <render_surface id="web_view" flex="1">
            <media_player id="test_video" source="test_media.mp4" autoplay="true" loop="true" />
        </render_surface>
    </container>
</dow>
